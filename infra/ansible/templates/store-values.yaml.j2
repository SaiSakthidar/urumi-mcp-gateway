# Generated by Ansible for the AWS k3s server. Same chart, configuration only.
domain: "{{ public_ip }}.sslip.io"
scheme: {{ 'https' if enable_tls else 'http' }}
ingress:
  tls:
    enabled: {{ enable_tls | lower }}
    clusterIssuer: "{{ 'letsencrypt-prod' if enable_tls else '' }}"
persistence:
  storageClass: local-path
networkPolicy:
  ingressController:
    namespace: kube-system   # k3s runs its bundled Traefik here
